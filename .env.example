# ==============================================================================
# Setu Raksha Environment Configuration Template
# ==============================================================================

# Core Application Environment
ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Kolkata
APP_NAME="Setu Raksha - National Bridge Safety Grid"
API_V1_STR=/api/v1

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL 16 with PostGIS)
POSTGRES_USER=setu_user
POSTGRES_PASSWORD=setu_secure_password_123
POSTGRES_DB=setu_raksha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://setu_user:setu_secure_password_123@localhost:5432/setu_raksha

# Redis (Cache, Celery broker, and SSE)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3-Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecure
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_EVIDENCE=setu-evidence

# Notifications & SMTP (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@seturaksha.gov.in
MAILPIT_UI_PORT=8025

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=["en","hi","mr"]
